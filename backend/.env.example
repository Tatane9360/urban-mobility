# Managed Postgres (Neon/Render): single URL, takes priority over the DB_* vars below.
# The server certificate is always verified. Neon and Render use a public CA,
# so nothing else is needed; set DB_CA_CERT only for a host with a private CA.
# sslmode=verify-full plutôt que require : identique aujourd'hui, mais pg v9
# rendra `require` plus permissif (plus de vérification du certificat).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=verify-full
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Schema auto-sync is on ONLY for NODE_ENV=development or test. Any other
# value (including unset) leaves the schema untouched at boot.
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=urbanmobility
DB_PASSWORD=urbanmobility
DB_NAME=urbanmobility
GTFS_STATIC_URL=https://data.montpellier3m.fr/sites/default/files/ressources/TAM_MMM_GTFS.zip
GBFS_STATION_INFORMATION_URL=https://gbfs.theta.fifteen.eu/gbfs/2.2/montpellier/en/station_information.json
GBFS_STATION_STATUS_URL=https://gbfs.theta.fifteen.eu/gbfs/2.2/montpellier/en/station_status.json
GTFS_RT_URBAIN_VEHICLE_POSITION_URL=https://data.montpellier3m.fr/GTFS/Urbain/VehiclePosition.pb
GTFS_RT_SUBURBAIN_VEHICLE_POSITION_URL=https://data.montpellier3m.fr/GTFS/Suburbain/VehiclePosition.pb
# TripUpdate + Alert. Optional: GtfsRtService defaults to these exact URLs
# if unset (see endpoints.md), so an older .env keeps working.
GTFS_RT_URBAIN_TRIP_UPDATE_URL=https://data.montpellier3m.fr/GTFS/Urbain/TripUpdate.pb
GTFS_RT_SUBURBAIN_TRIP_UPDATE_URL=https://data.montpellier3m.fr/GTFS/Suburbain/TripUpdate.pb
GTFS_RT_URBAIN_ALERT_URL=https://data.montpellier3m.fr/GTFS/Urbain/Alert.pb
GTFS_RT_SUBURBAIN_ALERT_URL=https://data.montpellier3m.fr/GTFS/Suburbain/Alert.pb
JWT_SECRET=change-me
# Get a free key at https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=change-me
CORS_ORIGIN=http://localhost:3000
# Optional, default to 100 requests per 60s per IP if unset
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Optional error monitoring. Point at a Sentry project DSN in dev, or a self-hosted GlitchTip DSN in prod (same protocol).
SENTRY_DSN=
