# The e2e suites TRUNCATE shared tables and seed their own GTFS fixtures, so
# they must never point at the database you develop against — running them
# once would wipe the imported TaM data (2000+ stops, 500k+ stop_times).
#
# Same Postgres container as .env, a different database. Create it once with:
#   docker exec urban-mobility-postgres-1 psql -U urbanmobility -d postgres \
#     -c "CREATE DATABASE urbanmobility_test;"
#   docker exec urban-mobility-postgres-1 psql -U urbanmobility -d urbanmobility_test \
#     -c "CREATE EXTENSION IF NOT EXISTS postgis;"
# TypeORM synchronize builds the schema on first run.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=urbanmobility
DB_PASSWORD=urbanmobility
DB_NAME=urbanmobility_test

# Fakes: the e2e suites stub every outbound call. Real keys here would let a
# test run hit a live quota.
JWT_SECRET=test-secret
OPENROUTESERVICE_API_KEY=test-key
GTFS_STATIC_URL=https://example.invalid/gtfs.zip
GBFS_STATION_INFORMATION_URL=https://example.invalid/station_information.json
GBFS_STATION_STATUS_URL=https://example.invalid/station_status.json
GTFS_RT_URBAIN_VEHICLE_POSITION_URL=https://example.invalid/urbain.pb
GTFS_RT_SUBURBAIN_VEHICLE_POSITION_URL=https://example.invalid/suburbain.pb
GTFS_RT_URBAIN_TRIP_UPDATE_URL=https://example.invalid/urbain-tu.pb
GTFS_RT_SUBURBAIN_TRIP_UPDATE_URL=https://example.invalid/suburbain-tu.pb
GTFS_RT_URBAIN_ALERT_URL=https://example.invalid/urbain-alert.pb
GTFS_RT_SUBURBAIN_ALERT_URL=https://example.invalid/suburbain-alert.pb
CORS_ORIGIN=http://localhost:3001
